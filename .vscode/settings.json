{
  // Hornvale's build output is enormous and there is a lot of it: a single
  // worktree's `target/debug/deps` was measured at 112,264 files, and the
  // repo normally carries three to five campaign worktrees under
  // `.claude/worktrees/` on top of this checkout, each with its own `target/`.
  // Anything that walks that tree takes minutes per pass.
  //
  // WHAT OCCASIONED THIS FILE: on 2026-08-17 an extension spawned 826
  // concurrent `rg` processes against VS Code's own bundled ripgrep, all
  // children of one extension host, with ages spanning 3 s to 2 h 58 m — they
  // were hanging, not churning — and took the machine to a load average of
  // 417/701/648 on ten cores. 202 of them were spawned inside a single ~43 s
  // window while the oldest was already almost three hours old.
  //
  // THE CAUSE, IDENTIFIED AND REMOVED: `svsool.markdown-memo` 0.3.19, a
  // wiki-link extension whose bundle carries `createFileSystemWatcher` +
  // `findFiles` + `cacheWorkspace` and a `**/*.md` glob, so every file change
  // queued a full-workspace markdown scan. Its captured argv carried
  // `--no-ignore --follow`, which discards `.gitignore` and follows symlinks,
  // so each scan walked every `target/`. Under continuous cargo builds the
  // watcher fired faster than the scans could finish. Nathan uninstalled it,
  // which removes the trigger rather than relying on the exclusions below.
  //
  // HONEST LIMIT OF THIS FILE — AND A CORRECTION TO WHAT THIS COMMENT USED TO
  // SAY. An earlier version asserted that an extension reaching the ripgrep
  // binary is not bound by these settings. For the extension that actually
  // caused the storm that is FALSE, and the evidence was in hand when it was
  // written: it went through `findFiles`, and its captured argv carried this
  // machine's own `files.exclude` entry (`**/__pycache__`) among its `-g !`
  // globs — proof that the caller DID inherit the exclusion lists. What these
  // settings cannot bind is a flag the caller chooses for itself, which is
  // why an inherited exclusion list still coexisted with `--no-ignore`, and
  // they bind nothing at all in a process spawned outside the search API. So
  // this file narrows the blast radius; it is not a guarantee, and it is not
  // what fixed the storm — uninstalling the extension is.

  // File watching. Excluding a path here is cheap and has no downside for
  // these directories: nothing in them is hand-edited.
  "files.watcherExclude": {
    "**/target/**": true,
    "**/.claude/worktrees/**": true,
    "**/book/book/**": true,
    "**/node_modules/**": true
  },

  // Search. `target/` and the built book are generated, so hits in them are
  // noise. `.claude/worktrees/` is deliberately NOT excluded here — those are
  // real checkouts and searching across live campaigns is sometimes exactly
  // what you want, even though it returns duplicate hits.
  "search.exclude": {
    "**/target": true,
    "**/book/book": true
  },

  // rust-analyzer indexes what it is pointed at; the worktrees are separate
  // checkouts of this same workspace and re-indexing them buys nothing.
  "rust-analyzer.files.excludeDirs": [".claude/worktrees"],

  // The repo is Rust 2024 with a workspace-wide fmt discipline — `cargo fmt`
  // as the final step before every commit is a project rule, and fmt-gate
  // skips have historically been the most common review finding.
  "[rust]": {
    "editor.formatOnSave": true
  }
}
