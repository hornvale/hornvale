#!/usr/bin/env bash
# scripts/hooks/pre-commit — the cheap half of the gate (TOOL-14), plus three
# guards (see below).
#
# Runs `make quick` (fmt --check + clippy + type-audit + type-audit-report)
# before every commit that could change its outcome. These are the cheapest
# checks and the most common review finding per CLAUDE.md, so catching them
# here reserves the expensive `--workspace` test gate for pre-push/CI.
#
# Opt-in: enable with `make install-hooks` (sets core.hooksPath). Bypass a
# single commit with `git commit --no-verify` only when you have a reason —
# never to skip the fmt gate (CLAUDE.md forbids --no-verify for that).
#
# ORDER MATTERS: the three guards below are pure-git and effectively free, so
# they run BEFORE `make quick` — a commit that a guard will refuse should not
# first pay a build. `make quick` is last because it is the only expensive step
# in the common case.
#
# This file absorbed the two features of a second, orphaned hook that used to
# sit at the repo root (`hooks/pre-commit`, deleted 2026-07-31): the
# linked-worktree/main branch guard, and the skip-the-build-on-docs-only fast
# path. Only one hook can be active — core.hooksPath names a single directory —
# and the root one had drifted to a weaker check set while still advertising
# `git config core.hooksPath hooks` in its own header, so following that comment
# silently disabled the two incident-derived guards below.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# The linked-worktree branch guard. Campaigns run in worktrees under
# `.claude/worktrees/`, and a linked worktree sitting on `main` is essentially
# always a wrong-branch mistake — a campaign subagent committed to main that way
# once. The PRIMARY checkout on `main` is legitimate (merges, infra, docs), so
# the guard keys on linked-vs-primary (git-dir != git-common-dir), not on the
# branch name alone.
git_dir="$(cd "$(git rev-parse --git-dir)" && pwd -P)"
git_common="$(cd "$(git rev-parse --git-common-dir)" && pwd -P)"
branch="$(git symbolic-ref --short -q HEAD || echo DETACHED)"
if [[ "$git_dir" != "$git_common" && "$branch" == "main" ]]; then
    echo "pre-commit: refusing to commit to 'main' from a linked worktree —" >&2
    echo "            you are almost certainly on the wrong branch." >&2
    echo "            (The primary checkout may commit to main; a worktree may not.)" >&2
    exit 1
fi

# The golden-pins.sql tripwire guard. `tools/census/queries/calibrate/
# golden-pins.sql` deliberately duplicates every pinned calibration constant
# in the three calibration test files, checked against the committed census
# fixture as an independent second path (its own header explains why). That
# duplication has gone stale TWICE (2026-07-13 and 2026-07-20) because
# `make census-check` is not part of `make gate` and nobody remembered to run
# it by hand at re-pin time. Closing the gap by construction instead of by
# memory: any commit that stages one of the four files below must pass
# `make census-check` before it can land — ~2.5 minutes, only paid on the
# rare commit that actually touches these.
census_guard_files='windows/lab/tests/calibration\.rs|windows/lab/tests/branches_family_calibration\.rs|windows/lab/tests/gathering_calibration\.rs|tools/census/queries/calibrate/golden-pins\.sql'
if git diff --cached --name-only | grep -qE "^(${census_guard_files})$"; then
    echo "pre-commit: a calibration-pin file is staged — running 'make census-check' (~2.5 min; this is the golden-pins.sql tripwire guard)..." >&2
    if ! make census-check; then
        echo "pre-commit: 'make census-check' failed — a calibration test file and" >&2
        echo "tools/census/queries/calibrate/golden-pins.sql have drifted apart." >&2
        echo "Re-sync golden-pins.sql's literals to match the Rust pins exactly" >&2
        echo "(the Rust file is primary; never edit it to match the SQL) and" >&2
        echo "re-run 'make census-check' before committing." >&2
        echo "If duckdb/python3 aren't installed: brew install duckdb; then retry." >&2
        exit 1
    fi
fi

# The scratch-in-worktree guard. `.superpowers/` is campaign scratch — decision
# ledgers, sdd notes — and is already in `.gitignore`. But `git add -f`
# deliberately overrides `.gitignore`, and once a path is tracked the ignore
# stops applying at all, so a single forced add silently makes the file
# permanent. That has happened at least twice (a `chore: untrack .superpowers/
# scratch that slipped past its own gitignore` commit exists, and The Action
# Clock repeated it while freezing a baseline). The ledger is explicitly NOT
# the durable record — material entries are promoted into the spec at close —
# so committing it is always a mistake, never a judgment call.
#
# Closing it by construction: no commit may ADD or MODIFY anything under
# `.superpowers/`. `--diff-filter=d` excludes deletions deliberately —
# `git rm --cached` is the remediation this hook recommends, and refusing that
# would leave an already-tracked file impossible to untrack without
# `--no-verify`. (Found immediately, by this guard refusing its own commit.)
if git diff --cached --name-only --diff-filter=d | grep -qE '(^|/)\.superpowers/'; then
    echo "pre-commit: a .superpowers/ path is staged." >&2
    echo "That directory is campaign SCRATCH and is gitignored; it was almost" >&2
    echo "certainly added with 'git add -f'. The decision ledger is not the" >&2
    echo "durable record — promote material entries into the spec instead." >&2
    echo "" >&2
    git diff --cached --name-only --diff-filter=d | grep -E '(^|/)\.superpowers/' | sed 's/^/  /' >&2
    echo "" >&2
    echo "Unstage with: git rm --cached <path>   (the file stays on disk)" >&2
    exit 1
fi

# `make quick`, and the docs-only fast path.
#
# The repo commits a great many docs-only changes — chronicles, retrospectives,
# specs, decision records, the book — and none of them can change what
# fmt-check, clippy, or the type audit say. Paying a workspace `cargo clippy` on
# a chronicle edit is pure latency (~16 s warm on this box, minutes cold), so
# skip it when nothing staged can affect the verdict.
#
# The predicate is deliberately WIDER than the `*.rs` test the orphaned root
# hook used: fmt is configured by nothing here (no rustfmt.toml), but clippy
# reads `clippy.toml` (it holds the disallowed-types bans — no HashMap, no
# wall-clock), the build reads `Cargo.toml` / `Cargo.lock` /
# `.cargo/config.toml` / `rust-toolchain.toml`, and the type audit is its own
# crate under `tools/type-audit/` whose behaviour changes when IT changes.
# Missing any of those would let a real regression through on a commit that
# staged no `.rs` file at all.
#
# `docs/audits/type-audit-report.md` is in the list for the same reason: it
# is the ONE non-`.rs` file `make quick` itself directly verifies (the
# `type-audit-report` target, added in The Mire task 1b, diffs a fresh
# regen against this committed copy). A commit staging only a hand-edit or a
# bad merge resolution of that file — no `.rs`, no `Cargo.*` — used to match
# none of the alternatives above and skip `make quick` entirely, so the very
# check that exists to catch a stale report never ran on the commit most
# likely to make it stale. Verified empirically before this fix: staging
# only a dirtied copy of the file made this predicate fall through and
# `make quick` never ran, even though `make type-audit-report` alone failed
# on the same tree.
#
# NOTE — this fast path gates ONLY `make quick`. The three guards above run
# unconditionally, and that is load-bearing: `.superpowers/` scratch is markdown
# and `golden-pins.sql` is SQL, so hanging the whole hook on "is Rust staged"
# (as the root hook's early `exit 0` did) would have disabled both guards on
# precisely the commits that trip them.
rust_relevant='\.rs$|(^|/)Cargo\.(toml|lock)$|(^|/)clippy\.toml$|(^|/)rustfmt\.toml$|(^|/)rust-toolchain\.toml$|(^|/)\.cargo/|(^|/)tools/type-audit/|(^|/)docs/audits/type-audit-report\.md$'
if ! git diff --cached --name-only --diff-filter=ACMR | grep -qE "$rust_relevant"; then
    echo "pre-commit: no Rust-relevant paths staged — skipping 'make quick'." >&2
    exit 0
fi

if ! make quick; then
    echo "pre-commit: 'make quick' failed — fix fmt/clippy/type-audit before committing." >&2
    exit 1
fi
