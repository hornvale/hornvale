{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/hv-guard-bash.sh\" 2>/dev/null || printf '{}\\n'",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/board-render.sh\" 2>/dev/null || true",
            "timeout": 5,
            "statusMessage": "Reading the board"
          }
        ]
      }
    ]
  }
}
